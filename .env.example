# Copy this file to .env before running `docker compose up`.

# --- Simulated clock -------------------------------------------------------
SIM_DAY_SECONDS=300

# --- Kafka -------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
METER_TOPIC=meter-readings

# --- Postgres ------------------------------------------------------------
PG_HOST=postgres
PG_PORT=5432
PG_DB=smartgrid
PG_USER=smartgrid
PG_PASSWORD=smartgrid

# --- Shared data volume paths (inside containers) -------------------------
BATCH_DATA_DIR=/data/batch_incoming
RAW_ARCHIVE_DIR=/data/raw/meter_readings
CHECKPOINT_DIR=/data/checkpoints/streaming_job

# --- Airflow ---------------------------------------------------------------
AIRFLOW_API_BASE=http://airflow-webserver:8080/api/v1
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=admin
SPARK_MASTER_URL=spark://spark-master:7077

# --- Observability thresholds ---------------------------------------------
LOW_RENEWABLE_THRESHOLD=0.10
STALE_DATA_THRESHOLD_S=90
